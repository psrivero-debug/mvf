{
  "name": "ProyectoDocumento",
  "type": "object",
  "properties": {
    "proyecto_id": {
      "type": "string",
      "description": "ID del ProyectoConsultoria"
    },
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo del documento"
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "imagen",
        "texto"
      ],
      "default": "texto",
      "description": "Tipo de documento"
    },
    "file_url": {
      "type": "string",
      "description": "URL del archivo original (imagen)"
    },
    "contenido_texto": {
      "type": "string",
      "description": "Texto ingresado manualmente o transcrito por IA desde la imagen"
    },
    "fecha_documento": {
      "type": "string",
      "format": "date",
      "description": "Fecha del documento"
    }
  },
  "required": [
    "proyecto_id",
    "titulo"
  ]
}