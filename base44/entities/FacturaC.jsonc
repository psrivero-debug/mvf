{
  "name": "FacturaC",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero de comprobante (ej: 0001-00000001)"
    },
    "punto_venta": {
      "type": "string",
      "description": "Punto de venta (ej: 0001)",
      "default": "0001"
    },
    "fecha_emision": {
      "type": "string",
      "format": "date",
      "description": "Fecha de emisi\u00f3n"
    },
    "cliente_nombre": {
      "type": "string",
      "description": "Nombre o raz\u00f3n social del cliente"
    },
    "cliente_cuit_dni": {
      "type": "string",
      "description": "CUIT / DNI del cliente"
    },
    "cliente_condicion_iva": {
      "type": "string",
      "enum": [
        "consumidor_final",
        "monotributista",
        "responsable_inscripto",
        "exento",
        "no_responsable"
      ],
      "default": "consumidor_final",
      "description": "Condici\u00f3n IVA del cliente"
    },
    "cliente_domicilio": {
      "type": "string",
      "description": "Domicilio del cliente"
    },
    "concepto": {
      "type": "string",
      "enum": [
        "productos",
        "servicios",
        "productos_y_servicios"
      ],
      "default": "servicios",
      "description": "Tipo de concepto facturado"
    },
    "items": {
      "type": "array",
      "description": "Detalle de items de la factura",
      "items": {
        "type": "object",
        "properties": {
          "descripcion": {
            "type": "string"
          },
          "cantidad": {
            "type": "number"
          },
          "precio_unitario": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal antes de descuentos"
    },
    "descuento": {
      "type": "number",
      "default": 0,
      "description": "Descuento en pesos"
    },
    "total": {
      "type": "number",
      "description": "Total de la factura"
    },
    "forma_pago": {
      "type": "string",
      "enum": [
        "efectivo",
        "transferencia",
        "cheque",
        "tarjeta",
        "otro"
      ],
      "default": "transferencia",
      "description": "Forma de pago"
    },
    "estado": {
      "type": "string",
      "enum": [
        "emitida",
        "anulada"
      ],
      "default": "emitida"
    },
    "cae": {
      "type": "string",
      "description": "CAE (C\u00f3digo de Autorizaci\u00f3n Electr\u00f3nica)"
    },
    "cae_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vencimiento del CAE"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones adicionales"
    }
  },
  "required": [
    "fecha_emision",
    "cliente_nombre",
    "total"
  ]
}