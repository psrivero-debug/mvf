{
  "name": "CasoAnalisis",
  "type": "object",
  "properties": {
    "caso_id": {
      "type": "string",
      "description": "ID del EstudioCaso"
    },
    "agente": {
      "type": "string",
      "enum": [
        "lector_juridico",
        "abogado_defensor",
        "transcriptor",
        "analista"
      ],
      "description": "Agente de IA utilizado"
    },
    "consulta": {
      "type": "string",
      "description": "Pregunta o instrucci\u00f3n enviada"
    },
    "respuesta": {
      "type": "string",
      "description": "Respuesta del agente"
    },
    "documentos_referenciados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de documentos citados en el an\u00e1lisis"
    },
    "contexto_hash": {
      "type": "string",
      "description": "Hash del contexto de documentos usado (IDs + versi\u00f3n del contenido). Si cambia el contexto, la misma consulta se guarda como versi\u00f3n nueva en el historial"
    }
  },
  "required": [
    "caso_id",
    "agente"
  ]
}