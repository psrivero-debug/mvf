{
  "name": "ProyectoConsultoria",
  "type": "object",
  "properties": {
    "consultor_id": {
      "type": "string",
      "description": "ID del consultor asignado (juridico, financiero, laboral, previsional, inmobiliario, familia)"
    },
    "titulo": {
      "type": "string",
      "description": "Nombre del proyecto"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n del caso a tratar"
    },
    "estado": {
      "type": "string",
      "enum": [
        "activo",
        "cerrado"
      ],
      "default": "activo",
      "description": "Estado del proyecto"
    }
  },
  "required": [
    "consultor_id",
    "titulo"
  ]
}