{
  "name": "Client",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre/s del cliente"
    },
    "apellido": {
      "type": "string",
      "description": "Apellido/s del cliente"
    },
    "full_name": {
      "type": "string",
      "description": "Nombre completo (generado autom\u00e1ticamente)"
    },
    "dni_cuit": {
      "type": "string",
      "description": "DNI o CUIT del cliente"
    },
    "tipo_dni": {
      "type": "string",
      "enum": [
        "DNI",
        "CUIT",
        "CUIL",
        "Pasaporte",
        "Otro"
      ],
      "default": "DNI",
      "description": "Tipo de documento"
    },
    "estado_civil": {
      "type": "string",
      "enum": [
        "soltero",
        "casado",
        "divorciado",
        "viudo",
        "union_convivencial",
        "separado"
      ],
      "description": "Estado civil del cliente"
    },
    "email": {
      "type": "string",
      "description": "Correo electr\u00f3nico"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "address": {
      "type": "string",
      "description": "Domicilio completo"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "persona_fisica",
        "persona_juridica"
      ],
      "default": "persona_fisica",
      "description": "Tipo de cliente"
    },
    "ocupacion": {
      "type": "string",
      "description": "Ocupaci\u00f3n o profesi\u00f3n del cliente"
    },
    "datos_a_tener_en_cuenta": {
      "type": "string",
      "description": "Datos relevantes a tener en cuenta sobre el cliente"
    },
    "notes": {
      "type": "string",
      "description": "Notas internas sobre el cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "inactivo"
      ],
      "default": "activo"
    }
  },
  "required": [
    "nombre",
    "apellido",
    "dni_cuit",
    "address",
    "estado_civil"
  ]
}