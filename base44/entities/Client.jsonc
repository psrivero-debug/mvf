{
  "name": "Client",
  "type": "object",
  "properties": {
    "client_type": {
      "type": "string",
      "enum": [
        "persona_fisica",
        "persona_juridica"
      ],
      "default": "persona_fisica",
      "description": "Tipo de cliente"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre/s del cliente (persona f\u00edsica)"
    },
    "apellido": {
      "type": "string",
      "description": "Apellido/s del cliente (persona f\u00edsica)"
    },
    "full_name": {
      "type": "string",
      "description": "Nombre completo o raz\u00f3n social (generado)"
    },
    "razon_social": {
      "type": "string",
      "description": "Raz\u00f3n social (persona jur\u00eddica)"
    },
    "dni_cuit": {
      "type": "string",
      "description": "DNI / CUIT del cliente"
    },
    "tipo_dni": {
      "type": "string",
      "enum": [
        "DNI",
        "CUIT",
        "CUIL",
        "Pasaporte",
        "Otro"
      ],
      "default": "DNI",
      "description": "Tipo de documento"
    },
    "condicion_iva": {
      "type": "string",
      "enum": [
        "responsable_inscripto",
        "monotributista",
        "exento",
        "consumidor_final",
        "no_responsable"
      ],
      "description": "Condici\u00f3n frente al IVA (persona jur\u00eddica)"
    },
    "representante_legal": {
      "type": "string",
      "description": "Nombre del representante legal (persona jur\u00eddica)"
    },
    "dni_representante": {
      "type": "string",
      "description": "DNI del representante legal"
    },
    "estado_civil": {
      "type": "string",
      "enum": [
        "soltero",
        "casado",
        "divorciado",
        "viudo",
        "union_convivencial",
        "separado"
      ],
      "description": "Estado civil (persona f\u00edsica)"
    },
    "email": {
      "type": "string",
      "description": "Correo electr\u00f3nico"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "address": {
      "type": "string",
      "description": "Domicilio completo"
    },
    "localidad": {
      "type": "string",
      "description": "Localidad / Ciudad"
    },
    "ocupacion": {
      "type": "string",
      "description": "Ocupaci\u00f3n o profesi\u00f3n del cliente"
    },
    "datos_a_tener_en_cuenta": {
      "type": "string",
      "description": "Datos relevantes a tener en cuenta sobre el cliente"
    },
    "notes": {
      "type": "string",
      "description": "Notas internas sobre el cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "inactivo"
      ],
      "default": "activo"
    }
  },
  "required": [
    "client_type"
  ]
}