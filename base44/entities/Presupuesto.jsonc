{
  "name": "Presupuesto",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero de presupuesto"
    },
    "client_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "fecha_emision": {
      "type": "string",
      "format": "date",
      "description": "Fecha de emisi\u00f3n"
    },
    "fecha_vencimiento": {
      "type": "string",
      "format": "date",
      "description": "Fecha de vencimiento (15 d\u00edas)"
    },
    "conceptos_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de aranceles IUS seleccionados"
    },
    "conceptos_nombres": {
      "type": "string",
      "description": "Nombres de conceptos seleccionados (texto)"
    },
    "concepto_extra_descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n del concepto adicional fuera de tabla IUS"
    },
    "concepto_extra_monto": {
      "type": "number",
      "description": "Monto del concepto adicional fuera de tabla IUS"
    },
    "adelanto": {
      "type": "number",
      "default": 0,
      "description": "Monto de adelanto ya abonado"
    },
    "monto_base": {
      "type": "number",
      "description": "Monto base del arancel (sin IVA)"
    },
    "monto_efectivo_desc": {
      "type": "number",
      "description": "Monto efectivo con 10% de descuento"
    },
    "monto_contado": {
      "type": "number",
      "description": "Monto contado 1 pago"
    },
    "cuotas_6": {
      "type": "number",
      "description": "Valor cuota a 6 meses"
    },
    "cuotas_12": {
      "type": "number",
      "description": "Valor cuota a 12 meses (+10%)"
    },
    "notas": {
      "type": "string",
      "description": "Observaciones adicionales"
    },
    "estado": {
      "type": "string",
      "enum": [
        "vigente",
        "vencido",
        "aceptado"
      ],
      "default": "vigente"
    }
  },
  "required": [
    "client_name",
    "fecha_emision"
  ]
}